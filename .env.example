# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=checkanalyze
DB_USER=checkanalyze
DB_PASSWORD=changeme

# Directory to store incoming receipt files
RECEIPTS_DIR=/opt/CheckAnalyze/receipts

# IMAP mailbox settings
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USERNAME=receipts@example.com
IMAP_PASSWORD=changeme
IMAP_MAILBOX=INBOX

# Telegram bot configuration
TELEGRAM_BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_ADMIN_ID=123456789

# Default fallback user ID for email receipts
DEFAULT_USER_ID=1
